// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

enum Role {
  SUPER_ADMIN
  ADMIN
  BRANCH_MANAGER
  SELLER
}

model Tenant {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  domain         String?  @unique
  logoUrl        String?
  primaryColor   String?  @default("#000000")
  description    String?
  whatsappNumber String?
  active         Boolean  @default(true)

  users          User[]
  branches       Branch[]
  products       Product[]
  variants       Variant[]
  stocks         Stock[]
  stockMovements StockMovement[]
  sales          Sale[]
  saleItems      SaleItem[]
  whatsappOrders WhatsappOrder[]
  refreshTokens  RefreshToken[]
  customers      Customer[]
  carts          Cart[]
  cartItems      CartItem[]
  orders         Order[]
  orderItems     OrderItem[]
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String
  password  String
  role      Role
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens  RefreshToken[]
  sales          Sale[]
  stockMovements StockMovement[]

  @@unique([email, tenantId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Branch {
  id        String   @id @default(uuid())
  name      String
  type      String // physical | virtual
  address   String?
  hours     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  users User[]
  stock Stock[]
  sales Sale[]
  stockMovementsFrom StockMovement[] @relation("StockMovementFromBranch")
  stockMovementsTo   StockMovement[] @relation("StockMovementToBranch")
  carts Cart[]
  orders Order[]
}

model Product {
  id             String    @id @default(uuid())
  name           String
  imageUrl       String?
  batch          String?
  expirationDate DateTime?
  active         Boolean   @default(true)
  baseAttributes Json?     @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])

  variants Variant[]
}

model Variant {
  id         String   @id @default(uuid())
  productId  String
  tenantId   String
  sku        String
  price      Float
  cost       Float
  attributes Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  product    Product  @relation(fields: [productId], references: [id])
  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  stock     Stock[]
  saleItems SaleItem[]
  stockMovements StockMovement[]
  cartItems CartItem[]
  orderItems OrderItem[]

  @@unique([tenantId, sku])
}

model Stock {
  id        String  @id @default(uuid())
  variantId String
  branchId  String
  quantity  Int
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  variant   Variant @relation(fields: [variantId], references: [id])
  branch    Branch  @relation(fields: [branchId], references: [id])

  @@unique([tenantId, variantId, branchId])
}

model StockMovement {
  id               String   @id @default(uuid())
  variantId        String
  variant          Variant  @relation(fields: [variantId], references: [id])
  fromBranchId     String?
  toBranchId       String?
  quantity         Int
  receivedQuantity Int?
  type             String // ADJUST | TRANSFER | SALE
  status           String   @default("COMPLETED") // PENDING | COMPLETED | CANCELLED
  userId           String?
  user             User?    @relation(fields: [userId], references: [id])
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  fromBranch       Branch?  @relation("StockMovementFromBranch", fields: [fromBranchId], references: [id])
  toBranch         Branch?  @relation("StockMovementToBranch", fields: [toBranchId], references: [id])
  createdAt        DateTime @default(now())
}

model Sale {
  id        String   @id @default(uuid())
  branchId  String
  userId    String
  total     Float
  createdAt DateTime @default(now())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  branch Branch     @relation(fields: [branchId], references: [id])
  user   User       @relation(fields: [userId], references: [id])
  items  SaleItem[]
}

model SaleItem {
  id        String @id @default(uuid())
  saleId    String
  variantId String
  quantity  Int
  price     Float
  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id])

  sale    Sale    @relation(fields: [saleId], references: [id])
  variant Variant @relation(fields: [variantId], references: [id])
}

model WhatsappOrder {
  id            String   @id @default(uuid())
  customerName  String
  customerPhone String
  message       String
  status        String // pending | processing | completed
  total         Float
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  createdAt     DateTime @default(now())
}

model Customer {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  phone     String
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@unique([tenantId, phone])
}

model Cart {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  sessionId String
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  status    String   @default("active") // active | submitted | abandoned
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items     CartItem[]

  @@unique([tenantId, sessionId])
}

model CartItem {
  id                String  @id @default(uuid())
  cartId            String
  cart              Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId         String
  variant           Variant @relation(fields: [variantId], references: [id])
  quantity          Int
  unitPriceSnapshot Float
  tenantId          String
  tenant            Tenant  @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, cartId, variantId])
}

model Order {
  id               String   @id @default(uuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  cartId           String?
  branchId         String
  branch           Branch   @relation(fields: [branchId], references: [id])
  customerId       String?
  customer         Customer? @relation(fields: [customerId], references: [id])
  representativeId String?
  customerName     String
  customerPhone    String
  customerNotes    String?
  status           String   @default("pending") // pending | contacted | confirmed | completed | cancelled
  totalSnapshot    Float
  whatsappMessage  String
  whatsappUrl      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  items            OrderItem[]
}

model OrderItem {
  id                 String  @id @default(uuid())
  orderId            String
  order              Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId          String
  variant            Variant @relation(fields: [variantId], references: [id])
  quantity           Int
  unitPriceSnapshot  Float
  skuSnapshot        String
  attributesSnapshot Json
  tenantId           String
  tenant             Tenant  @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, orderId, variantId])
}
